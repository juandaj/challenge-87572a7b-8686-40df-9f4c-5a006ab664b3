# Copy values into your IDE Run Configuration or shell environment.
# Never commit real credentials.
JWT_SECRET_BASE64=<generate-with-openssl-rand-base64-32>
APP_USER_PASSWORD=<strong-local-password>
APP_ADMIN_PASSWORD=<different-strong-local-password>

# Optional overrides
JWT_ISSUER=pragma-security-challenge
JWT_EXPIRATION_SECONDS=900
APP_USER_USERNAME=challenge-user
APP_ADMIN_USERNAME=challenge-admin
SERVER_PORT=8080
